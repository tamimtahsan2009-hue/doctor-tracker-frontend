# Doctor Tracker - Frontend Environment Variables Template
# Database & Authentication (when running unified Next.js API)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/doctortracker?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here_min_32_chars
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Standalone Backend API URL (for decoupled microservice mode with doctor-tracker-backend)
# Leave blank/commented out to use built-in Next.js endpoints
# NEXT_PUBLIC_API_URL=http://localhost:5000
